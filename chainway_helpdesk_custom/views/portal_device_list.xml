<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="portal_device_list" name="My Devices">

        <t t-call="portal.portal_layout">

            <style>
                @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&amp;family=Syne:wght@700;800&amp;display=swap');

                :root {
                    --bg:        #F4F6FA;
                    --surface:   #FFFFFF;
                    --border:    #E2E8F2;
                    --accent:    #2563EB;
                    --accent-lt: #EFF4FF;
                    --text-hd:   #0F172A;
                    --text-body: #334155;
                    --text-mute: #94A3B8;
                    --success:   #16A34A;
                    --radius:    12px;
                    --shadow:    0 4px 24px rgba(15,23,42,.07);
                }

                .dv-page {
                    min-height: 100vh;
                    padding: 48px 24px 80px;
                    font-family: 'DM Sans', sans-serif;
                    color: var(--text-body);
                }

                .dv-header {
                    display: flex;
                    align-items: flex-end;
                    justify-content: space-between;
                    flex-wrap: wrap;
                    gap: 12px;
                    margin-bottom: 32px;
                }

                .dv-header-left h1 {
                    font-family: 'Syne', sans-serif;
                    font-weight: 800;
                    font-size: 2rem;
                    color: var(--text-hd);
                    letter-spacing: -0.5px;
                    margin: 0 0 4px;
                    line-height: 1.1;
                }

                .dv-header-left h1 span {
                    color: var(--accent);
                }

                .dv-header-left p {
                    font-size: .875rem;
                    color: var(--text-mute);
                    margin: 0;
                }

                .dv-card {
                    background: var(--surface);
                    border: 1px solid var(--border);
                    border-radius: var(--radius);
                    box-shadow: var(--shadow);
                    overflow: hidden;
                }

                .dv-table-scroll {
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                }

                .dv-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: .83rem;
                    white-space: nowrap;
                }

                .dv-table thead tr {
                    background: var(--text-hd);
                }

                .dv-table thead th {
                    color: #CBD5E1;
                    font-weight: 600;
                    font-size: .72rem;
                    letter-spacing: .8px;
                    text-transform: uppercase;
                    padding: 14px 16px;
                    text-align: left;
                    border: none;
                }

                .dv-table tbody tr {
                    border-bottom: 1px solid var(--border);
                    transition: background .15s;
                }

                .dv-table tbody tr:last-child {
                    border-bottom: none;
                }

                .dv-table tbody tr:hover {
                    background: #F8FAFF;
                }

                .dv-table td {
                    padding: 13px 16px;
                    color: var(--text-body);
                    vertical-align: middle;
                }

                .dv-table td:first-child {
                    color: var(--text-mute);
                    font-weight: 600;
                    font-size: .78rem;
                }

                .dv-pill {
                    display: inline-block;
                    background: var(--accent-lt);
                    color: var(--accent);
                    font-weight: 600;
                    font-size: .75rem;
                    padding: 3px 9px;
                    border-radius: 6px;
                    letter-spacing: .2px;
                }

                .dv-dash {
                    color: var(--text-mute);
                    font-size: .85rem;
                }

                .dv-pod-btn {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 6px;
                    background: var(--accent);
                    color: #fff !important;
                    border-radius: 7px;
                    padding: 6px 12px;
                    font-size: .75rem;
                    font-weight: 600;
                    text-decoration: none !important;
                    transition: all .2s;
                    box-shadow: 0 2px 8px rgba(37,99,235,.20);
                }

                .dv-pod-btn:hover {
                    background: #1D4ED8;
                    color: #fff !important;
                    transform: translateY(-1px);
                    box-shadow: 0 4px 12px rgba(37,99,235,.30);
                }

                .dv-pod-btn svg {
                    width: 14px;
                    height: 14px;
                    flex-shrink: 0;
                }

                .dv-empty {
                    padding: 64px 24px;
                    text-align: center;
                }

                .dv-empty-icon {
                    width: 56px;
                    height: 56px;
                    background: var(--accent-lt);
                    border-radius: 14px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin: 0 auto 16px;
                }

                .dv-empty p {
                    color: var(--text-mute);
                    font-size: .9rem;
                    margin: 0;
                }

                .dv-empty strong {
                    display: block;
                    font-size: 1rem;
                    color: var(--text-hd);
                    font-weight: 600;
                    margin-bottom: 4px;
                }

                .dv-footer {
                    padding: 12px 20px;
                    background: #FAFBFD;
                    border-top: 1px solid var(--border);
                    font-size: .78rem;
                    color: var(--text-mute);
                }

                .dv-search-container {
                    margin-bottom: 24px;
                }

                .dv-search-wrapper {
                    display: flex;
                    align-items: center;
                    background: var(--surface);
                    border: 1px solid var(--border);
                    border-radius: var(--radius);
                    padding: 0 14px;
                    margin: 0;
                    box-shadow: 0 2px 8px rgba(15,23,42,.04);
                    transition: border-color .2s, box-shadow .2s;
                }

                .dv-search-wrapper:focus-within {
                    border-color: var(--accent);
                    box-shadow: 0 2px 12px rgba(37,99,235,.12);
                }

                .dv-search-icon {
                    color: var(--text-mute);
                    flex-shrink: 0;
                    margin-right: 10px;
                }

                .dv-search-input {
                    flex: 1;
                    border: none;
                    background: transparent;
                    padding: 11px 0;
                    font-size: .9rem;
                    font-family: 'DM Sans', sans-serif;
                    color: var(--text-body);
                    outline: none;
                }

                .dv-search-input::placeholder {
                    color: var(--text-mute);
                }

                .dv-search-clear {
                    background: none;
                    border: none;
                    padding: 4px 6px;
                    cursor: pointer;
                    color: var(--text-mute);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 4px;
                    text-decoration: none !important;
                }

                .dv-search-clear:hover {
                    background: var(--accent-lt);
                    color: var(--accent);
                }

                .dv-btn-export {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    background: var(--surface);
                    border: 1px solid var(--border);
                    color: var(--accent) !important;
                    font-size: .85rem;
                    font-weight: 600;
                    padding: 8px 16px;
                    border-radius: 8px;
                    text-decoration: none !important;
                    transition: all .2s;
                    cursor: pointer;
                }

                .dv-btn-export:hover {
                    border-color: var(--accent);
                    background: var(--accent-lt);
                    transform: translateY(-1px);
                }

                @media (max-width: 768px) {

                    .dv-page {
                        padding: 28px 12px 60px;
                    }

                    .dv-header-left h1 {
                        font-size: 1.6rem;
                    }

                    .dv-header {
                        align-items: flex-start;
                    }

                    .dv-table {
                        font-size: .78rem;
                    }

                    .dv-table thead th,
                    .dv-table td {
                        padding: 10px 12px;
                    }

                }
            </style>


            <div class="dv-page">

                <div class="container-fluid" style="max-width:1600px;margin:0 auto;">

                    <!-- PAGE HEADER -->
                    <div class="dv-header">

                        <div class="dv-header-left">
                            <h1>My <span>Devices</span></h1>
                            <p>
                                Track delivery status, serial numbers, and proof of delivery
                                for all assigned devices.
                            </p>
                        </div>

                        <div style="display:flex;align-items:center;gap:12px;">
                            <a href="/my/devices/download_excel"
                               class="dv-btn-export"
                               title="Download device data as Excel">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                    <polyline points="7 10 12 15 17 10"/>
                                    <line x1="12" y1="15" x2="12" y2="3"/>
                                </svg>
                                Export Excel
                            </a>
                        </div>

                    </div>


                    <!-- SEARCH (server-side) -->
                    <div class="dv-search-container">
                        <form action="/my/devices" method="get" class="dv-search-wrapper">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="dv-search-icon">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.35-4.35"/>
                            </svg>

                            <input type="text"
                                   name="search"
                                   t-att-value="search"
                                   class="dv-search-input"
                                   placeholder="Search by serial number, PO, invoice, vendor, or tracking ID..."/>

                            <a t-if="search" href="/my/devices" class="dv-search-clear" title="Clear">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"/>
                                    <line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                            </a>
                        </form>
                    </div>


                    <!-- TABLE -->
                    <div class="dv-card">

                        <div class="dv-table-scroll">

                            <table class="dv-table">

                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Vendor Name</th>
                                        <th>PO Date</th>
                                        <th>PO No.</th>
                                        <th>Invoice No.</th>
                                        <th>Invoice Date</th>
                                        <th>Store Name</th>
                                        <th>Store Code</th>
                                        <th>Ship. Address (PO)</th>
                                        <th>Ship. Address (Invoice)</th>
                                        <th>Delivery Location</th>
                                        <th>Serial Number</th>
                                        <th>Description</th>
                                        <th>Courier</th>
                                        <th>Tracking ID</th>
                                        <th>Delivery Date</th>
                                        <th>POD</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <t t-if="devices">

                                        <!-- d.pod_copy is deliberately NOT accessed (Binary field -> MemoryError) -->
                                        <t t-foreach="devices" t-as="d">

                                            <tr>

                                                <!-- Row number (continues across pages) -->
                                                <td><t t-esc="pager['offset'] + d_index + 1"/></td>

                                                <!-- Vendor -->
                                                <td style="font-weight:500;color:#0F172A;">
                                                    <t t-esc="d.end_user_name.name or '-'"/>
                                                </td>

                                                <!-- PO Date -->
                                                <td><t t-esc="d.po_date or '-'"/></td>

                                                <!-- PO Number -->
                                                <td>
                                                    <t t-if="d.po_no">
                                                        <span class="dv-pill"><t t-esc="d.po_no"/></span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="dv-dash">—</span>
                                                    </t>
                                                </td>

                                                <!-- Invoice Number -->
                                                <td>
                                                    <t t-if="d.invoice_no">
                                                        <span class="dv-pill"><t t-esc="d.invoice_no"/></span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="dv-dash">—</span>
                                                    </t>
                                                </td>

                                                <!-- Invoice Date -->
                                                <td><t t-esc="d.invoice_date or '-'"/></td>

                                                <!-- Store Name -->
                                                <td style="font-weight:500;">
                                                    <t t-esc="d.location or '-'"/>
                                                </td>

                                                <!-- Store Code -->
                                                <td><t t-esc="d.location_code or '-'"/></td>

                                                <!-- Shipping Address PO -->
                                                <td style="white-space:normal;max-width:160px;line-height:1.45;">
                                                    <t t-esc="d.shipping_address_po or '-'"/>
                                                </td>

                                                <!-- Shipping Address Invoice -->
                                                <td style="white-space:normal;max-width:160px;line-height:1.45;">
                                                    <t t-esc="d.shipping_address_invoice or '-'"/>
                                                </td>

                                                <!-- Delivery Location -->
                                                <td><t t-esc="d.delivery_location or '-'"/></td>

                                                <!-- Serial Number -->
                                                <td style="font-family:monospace;font-size:.8rem;letter-spacing:.3px;">
                                                    <t t-esc="d.device_sn or '-'"/>
                                                </td>

                                                <!-- Description -->
                                                <td style="white-space:normal;max-width:180px;line-height:1.45;">
                                                    <t t-esc="d.description or '-'"/>
                                                </td>

                                                <!-- Courier -->
                                                <td><t t-esc="d.courier_name or '-'"/></td>

                                                <!-- Tracking ID -->
                                                <td style="font-family:monospace;font-size:.8rem;">
                                                    <t t-esc="d.tracking_id or '-'"/>
                                                </td>

                                                <!-- Delivery Date -->
                                                <td style="font-weight:500;color:#16A34A;">
                                                    <t t-esc="d.delivery_date or '-'"/>
                                                </td>

                                                <!-- POD -->
                                                <td>
                                                    <a t-att-href="'/my/device/pod/%s' % d.id"
                                                       class="dv-pod-btn"
                                                       target="_blank"
                                                       title="View POD">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             viewBox="0 0 24 24" fill="none"
                                                             stroke="currentColor" stroke-width="2"
                                                             stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/>
                                                            <circle cx="12" cy="12" r="3"/>
                                                        </svg>
                                                        View POD
                                                    </a>
                                                </td>

                                            </tr>

                                        </t>

                                    </t>


                                    <!-- EMPTY STATE -->
                                    <t t-else="">
                                        <tr>
                                            <td colspan="17" style="padding:0;border:none;">
                                                <div class="dv-empty">

                                                    <div class="dv-empty-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26"
                                                             viewBox="0 0 24 24" fill="none" stroke="#2563EB"
                                                             stroke-width="1.8" stroke-linecap="round"
                                                             stroke-linejoin="round">
                                                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                                                            <line x1="12" y1="12" x2="12" y2="16"/>
                                                            <line x1="10" y1="14" x2="14" y2="14"/>
                                                        </svg>
                                                    </div>

                                                    <strong>No devices found</strong>

                                                    <p t-if="search">
                                                        No devices match your search.
                                                    </p>
                                                    <p t-else="">
                                                        There are currently no devices assigned to your account.
                                                    </p>

                                                </div>
                                            </td>
                                        </tr>
                                    </t>

                                </tbody>

                            </table>

                        </div>


                        <!-- FOOTER -->
                        <t t-if="devices">
                            <div class="dv-footer">
                                Showing <strong><t t-esc="len(devices)"/></strong>
                                of <strong><t t-esc="total"/></strong>
                                device<t t-if="total != 1">s</t>
                            </div>
                        </t>

                    </div>


                    <!-- PAGER -->
                    <div class="d-flex justify-content-center mt-4">
                        <t t-call="portal.pager"/>
                    </div>

                </div>

            </div>

        </t>

    </template>


    <!-- Device User Group -->
    <record id="group_device_user" model="res.groups">
        <field name="name">Device User</field>
    </record>

</odoo>